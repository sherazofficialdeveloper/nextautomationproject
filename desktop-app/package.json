{
  "name": "netx-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "NETX user-facing desktop software (Electron + React + Vite).",
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev:renderer": "vite --port 5173 --strictPort",
    "dev:electron": "node electron/run.js --dev-server=http://localhost:5173",
    "build": "vite build",
    "start": "npm run build && node electron/run.js",
    "smoke": "npm run build && node electron/run.js --smoke",
    "lint": "eslint ."
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "vite": "^8.3.0"
  }
}
