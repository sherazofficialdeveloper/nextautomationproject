# NETX Platform Backend Environment Configuration
PORT=3000
DATABASE_URL="postgresql://user:password@localhost:5432/railway_license_platform"
JWT_SECRET="YOUR_VERY_STRONG_AND_RANDOM_SECRET_KEY"

# PostgreSQL Connection URL
DATABASE_URL="postgresql://postgres:password@localhost:5432/next-railway_license_platform"

# Authentication JWT Secret (HMAC SHA-256)
JWT_SECRET="replace-with-a-secure-random-256-bit-hex-secret"
JWT_EXPIRES_IN="1h"

# IRCTC External Credential AES-256-GCM Encryption Key
# If omitted, falls back to SHA-256 hash of JWT_SECRET.
# Keep this secret secure and outside source control!
CREDENTIAL_SECRET="replace-with-a-dedicated-aes256-encryption-secret"